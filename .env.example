# Copier en .env (jamais versionné). Valeurs de développement.
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
DATABASE_URL=postgres://vyra:vyra@127.0.0.1:5432/vyra_dev
# Production (lot H1) : le serveur se connecte avec vyra_app ; les migrations, avec vyra_migrator, par la
# commande dédiée uniquement. Ne jamais fournir MIGRATION_DATABASE_URL au serveur.
# DATABASE_URL=postgres://vyra_app:<mot de passe>@<hôte>:5432/vyra
# MIGRATION_DATABASE_URL=postgres://vyra_migrator:<mot de passe>@<hôte>:5432/vyra
# MIGRATION_SET_ROLE=vyra_owner
STORAGE_DIR=./storage
WEB_DIST_DIR=./dist/web
# E-mails : « outbox » en développement (lisibles sur /dev/mailbox), « brevo » en production.
MAIL_TRANSPORT=outbox
MAIL_FROM=VYRA <no-reply@example.invalid>
# BREVO_API_KEY=
# Paiements (Market, lots 5 à 7) : « none » tant que le Market n'est pas ouvert ; « sandbox » interdit en production.
PAYMENTS_PROVIDER=none
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# --- Production (voir docs/DEPLOIEMENT.md) ---
# SECRET_KEY=            # openssl rand -base64 32 (obligatoire en production)
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.example.eu:587?requireTLS=true
# FILE_SCAN=clamd        # obligatoire en production
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRESIGNED_DOWNLOADS=false
# RATE_LIMIT_STORE=postgres
# METRICS_TOKEN=         # 24 caractères au moins ; sans lui, /api/metrics n'existe pas
# TRUST_PROXY=true       # derrière un proxy inverse
